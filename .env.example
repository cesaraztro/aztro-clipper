# Copia este archivo a .env y llena solo lo que uses.
# Carpeta de trabajo (fuera de iCloud/OneDrive/Dropbox). Por defecto: ~/AztroClipper
CLIPPER_DATA=
# Forzar motor de transcripción: mlx | faster
CLIPPER_ASR=
# B-roll de bancos libres (opcional)
PEXELS_API_KEY=
# Diarización con pyannote (opcional, Fase 2)
HF_TOKEN=
# Modo sin agente: endpoint compatible con OpenAI para elegir clips
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# ManyChat Pro: endpoint que resuelve palabra -> link (opcional)
MANYCHAT_ENDPOINT_URL=
